# Copy to .env and fill in.  chmod 600 .env
# The file is never served over HTTP: only index.html and the two JS bundles are.

# ---------------------------------------------------------------- server
# 127.0.0.1 keeps the app on the loopback (use nginx in front of it).
# 0.0.0.0 is required inside Docker and is REFUSED unless RADAR_PASSWORD is set.
HOST=127.0.0.1
PORT=4174
# Where the .txt reports are written.  On a server keep it inside the project.
REPORT_DIR=/app/reports

# ------------------------------------------------------------------ auth
# Leave RADAR_PASSWORD empty ONLY for local loopback use.
# Anyone who can open the UI can place real orders once mode != dry-run.
RADAR_USER=radar
RADAR_PASSWORD=

# --------------------------------------------------------------- trading
# Needed only when the auto-trade mode is testnet or live.
# dry-run needs no credentials at all.

# Hyperliquid: an API wallet key created at https://app.hyperliquid.xyz/API
# Never the seed phrase of the main wallet.  Used locally to sign; never sent.
HYPERLIQUID_PRIVATE_KEY=
# The account the API wallet trades for (main wallet address).
HYPERLIQUID_ACCOUNT_ADDRESS=

# Bybit USDT perpetual futures (linear).  Spot is not used.
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=false

# ------------------------------------------------------------- optional
# Arkham powers only the transfers/swaps tab.  Everything else works without it.
ARKHAM_API_KEY=
ARKHAM_API_URL=https://api.arkm.com
BSCSCAN_API_KEY=
