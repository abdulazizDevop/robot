[Unit]
Description=Hyperliquid Radar web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hyperliquid-radar
ExecStart=/usr/bin/python3 /opt/hyperliquid-radar/server.py
Restart=always
RestartSec=3
User=radar
Group=radar
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
