# Secrets — never commit. .env holds the panel password and exchange keys.
.env
.env.*
!.env.example

# Runtime data: SQLite databases, caches, generated settings, reports.
# app/data is the DATA_DIR default and can reach tens of megabytes.
data/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal
trading_settings.json
reports/
hyperliquid_*_cache.json
saved_addresses.json

# Original Codex session export used to seed this project. Large, and it
# contains unrelated projects from the same export.
_source_export/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# OS / editors
.DS_Store
*.swp
.idea/
.vscode/
